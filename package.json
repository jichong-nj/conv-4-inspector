{
  "name": "@jichong/conv-4-inspector",
  "version": "1.0.2",
  "description": "LLM对话监视器 — track and display outbound LLM requests and their assembled responses in the DSH conversation view",
  "license": "MIT",
  "author": "jichong-nj",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jichong-nj/conv-4-inspector.git"
  },
  "homepage": "https://github.com/jichong-nj/conv-4-inspector#readme",
  "bugs": {
    "url": "https://github.com/jichong-nj/conv-4-inspector/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "llm",
    "inspector",
    "devtools",
    "observability"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "src",
    "locale",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node build.js",
    "prepare": "node build.js"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
